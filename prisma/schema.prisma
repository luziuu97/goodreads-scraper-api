datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Work {
  id               String   @id @default(uuid())
  slug             String   @unique
  canonicalTitle   String
  originalLanguage String?
  publicationYear  Int?
  averageRating    Float?
  ratingsCount     Int?
  reviewsCount     Int?
  textReviewsCount Int?
  popularityScore  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations      WorkTranslation[]
  titles            WorkTitle[]
  editions          Edition[]
  contributors      WorkContributor[]
  seriesMemberships WorkSeries[]
  genres            GenreOnWork[]
  externalIds       WorkExternalId[]

  @@index([canonicalTitle])
  @@index([ratingsCount])
  @@index([popularityScore])
}

model WorkTranslation {
  id          String  @id @default(uuid())
  workId      String
  work        Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  language    String
  title       String
  description String?

  @@unique([workId, language])
}

model WorkTitle {
  id              String  @id @default(uuid())
  workId          String
  work            Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  language        String?
  title           String
  normalizedTitle String
  isPrimary       Boolean @default(false)
  source          String?

  @@unique([workId, language, normalizedTitle])
  @@index([normalizedTitle])
  @@index([workId, language])
}

model Series {
  id            String              @id @default(uuid())
  slug          String              @unique
  canonicalName String
  booksCount    Int?
  translations  SeriesTranslation[]
  memberships   WorkSeries[]
  externalIds   SeriesExternalId[]

  @@index([canonicalName])
}

model SeriesTranslation {
  id          String  @id @default(uuid())
  seriesId    String
  series      Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  language    String
  name        String
  description String?

  @@unique([seriesId, language])
}

model WorkSeries {
  workId    String
  seriesId  String
  position  Float?
  isPrimary Boolean @default(false)
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  series    Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([workId, seriesId])
  @@index([seriesId, position])
}

model Author {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  workContributions    WorkContributor[]
  editionContributions EditionContributor[]
  externalIds          AuthorExternalId[]

  @@index([name])
}

model WorkContributor {
  workId    String
  authorId  String
  role      String  @default("AUTHOR")
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([workId, authorId, role])
  @@index([authorId])
  @@index([workId, isPrimary])
}

model EditionContributor {
  editionId String
  authorId  String
  role      String  @default("AUTHOR")
  position  Int     @default(0)
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([editionId, authorId, role])
  @@index([authorId])
}

model Edition {
  id               String   @id @default(uuid())
  workId           String
  work             Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  title            String
  format           String   @default("OTHER")
  language         String?
  isbn10           String?
  isbn13           String?
  asin             String?
  publisher        String?
  publicationDate  String?
  pages            Int?
  audioLengthMinutes Int?
  isDefault        Boolean  @default(false)
  ratingsCount     Int?
  textReviewsCount Int?
  popularityScore  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  covers       EditionCover[]
  contributors EditionContributor[]
  externalIds  EditionExternalId[]

  @@index([workId])
  @@index([isbn10])
  @@index([isbn13])
  @@index([asin])
  @@index([popularityScore])
}

model EditionCover {
  id          String   @id @default(uuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  provider    String
  url         String
  width       Int?
  height      Int?
  pixelCount  Int?
  imageFormat String?  @default("jpeg")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([editionId, url])
  @@index([editionId])
}

model Genre {
  id    String        @id @default(uuid())
  name  String        @unique
  works GenreOnWork[]
}

model GenreOnWork {
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  source  String @default("canonical")
  score   Int?

  @@id([workId, genreId, source])
  @@index([genreId])
}

model WorkExternalId {
  id         String @id @default(uuid())
  provider   String
  externalId String
  workId     String
  work       Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([workId])
}

model EditionExternalId {
  id         String  @id @default(uuid())
  provider   String
  externalId String
  editionId  String
  edition    Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([editionId])
}

model AuthorExternalId {
  id         String @id @default(uuid())
  provider   String
  externalId String
  authorId   String
  author     Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([authorId])
}

model SeriesExternalId {
  id         String @id @default(uuid())
  provider   String
  externalId String
  seriesId   String
  series     Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([seriesId])
}
