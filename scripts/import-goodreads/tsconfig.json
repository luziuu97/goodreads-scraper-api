{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "outDir": "../../.next/scripts",
    "rootDir": "../..",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "__tests__"]
}
